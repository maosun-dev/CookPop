    "test": "vitest run",
    "icon": "node tools/icon/make-assets.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@fontsource/zen-maru-gothic": "^5.2.6"
  }
}
