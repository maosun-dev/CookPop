{
  "name": "cookpop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "クックポップ：登録した YouTube の料理動画から、マスコットのポンが今日の献立を決めてくれる",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node tools/strip-woff.mjs",
    "sync": "npm run build && npx cap sync ios",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit",
    "test": "vitest run",
    "icon": "node tools/icon/make-assets.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.1.1",
    "@capgo/capacitor-share-target": "8.0.63",
    "@fontsource/zen-maru-gothic": "^5.2.6"
  }
}
