{
  "name": "cookpop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "クックポップ：登録した YouTube の料理動画から、マスコットのポンが今日の献立を決めてくれる",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
